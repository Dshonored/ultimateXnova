# --- Public URL (used for links in e-mails; never derived from the Host header) ---
APP_URL=https://game.example.com/

# --- Secrets: generate with `openssl rand -hex 32` ---
APP_SECRET=
APP_SALT=

# --- E-mail via Resend (https://resend.com). MAIL_FROM must be on a verified domain ---
RESEND_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=ultimateXnova

# --- Database ---
DB_NAME=ultimatexnova
DB_USER=uxn
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=uni1_

# --- Web ---
WEB_PORT=8080
# Set to 1 only while running the web installer the first time, then remove it
ALLOW_INSTALL=0
# Local development only: write login codes / verify links to the PHP error log
LOGIN_CODE_DEV_LOG=0
